{%- style -%}
  #shopify-section-{{ section.id }} {

  }
  .v-grid__image{
    width: 100%;
    height: auto;
    display: block;
  }
  #shopify-section-{{ section.id }} .v-grid{
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0,1fr));
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: {{ section.settings.max-width }};
    column-gap: {{ section.settings.column-gap }};
    row-gap: {{ section.settings.row-gap }};
    text-align: {{ section.settings.text_alignment }};
    img{
      display: block;
    }
    @media screen and (max-width: {{ section.settings.custom-breakpoint }}px) {
      {% if section.settings.reverse-on-mobile %}
        display: flex;
        flex-flow: column-reverse;
      {%  else %}
        grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0,1fr));
      {%  endif %}
    }
  }
{%- endstyle -%}

{% comment %} {% assign detect_when_in_view = section.settings.detect_when_in_view %} {% endcomment %}

<section
  class="
    v-grid__section
    {% if section.settings.bleed %} __container-bleed {% endif %}
    {%if section.settings.section_css_class %} {{section.settings.section_css_class}} {% endif %}
  "
>
  {% if section.settings.section_heading != blank %}
    <div class="title-wrapper">
      <h2 class="section-title">
        {{- section.settings.section_heading | escape -}}
      </h2>
    </div>
  {% endif %}
  <ul class="v-grid __align-{{section.settings.align_items}}">
    {%- for block in section.blocks -%}
      <li class="v-grid__grid-item">
        {% case block.type %}
          {% when 'feature_card' %}
            {%- liquid
              assign card_alt = block.settings.image.alt | default: block.settings.feature_card_text | strip_html
            -%}

            {% if block.settings.video != blank %}
              {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false }}
            {% endif %}

            {%- if block.settings.image -%}
              {{
                block.settings.image
                | image_url: width: 3200
                | image_tag:
                  loading: 'lazy',
                  widths: '200, 400, 600, 800, 1200, 1600, 2000, 3200',
                  sizes: '(min-width: 990px) 33vw, 100vw',
                  alt: card_alt,
                  class: 'v-grid__image'
              }}
            {%- endif -%}

            {%- if block.settings.feature_card_heading != blank -%}
              <h1 class="feature-card__heading __h1">
                {{ block.settings.feature_card_heading }}
              </h1>
            {%- endif -%}

            {%- if block.settings.feature_card_text -%}
              <div class="feature-card__text">{{ block.settings.feature_card_text }}</div>
            {%- endif -%}
            {%- if block.settings.feature_card_url -%}
              <div>
                <a href="{{ block.settings.feature_card_url }}" class="__cta">
                  {{ block.settings.feature_card_button_text }}
                </a>
              </div>
            {%- endif -%}

          {% when 'read_more_text' %}
            <style>
              .read-more-text__toggle {
                background: none;
                border: none;
                padding: 0;
                margin-top: 8px;
                color: inherit;
                text-decoration: underline;
                cursor: pointer;
                font-weight: normal;
                &:hover {
                  text-decoration: none;
                }
              }
            </style>
            {% assign raw_text = block.settings.read_more_text_description | strip_html %}
            {% assign word_limit = 30 %}
            {% comment %} Adjust desired word limit here {% endcomment %}
            <div class="read-more-text__description">
              {% if raw_text.size > 0 %}
                {% assign word_count = raw_text | split: ' ' | size %}

                {% if word_count > word_limit %}
                  {% comment %} {%- Shortened version shown by default -%} {% endcomment %}
                  <div class="read-more-text__short">
                    <p>{{ raw_text | truncatewords: word_limit, '...' }}</p>
                  </div>

                  {% comment %} {%- Full rich text version hidden by default -%} {% endcomment %}
                  <div class="read-more-text__full" style="display: none;">
                    {{ block.settings.read_more_text_description }}
                  </div>

                  <button type="button" class="read-more-text__toggle js--read-more-text__toggle" aria-expanded="false">
                    Read more
                  </button>
                {% else %}
                  {% comment %} {%- Text is short enough, display directly -%} {% endcomment %}
                  <div class="read-more-text__full">
                    {{ block.settings.read_more_text_description }}
                  </div>
                {% endif %}
              {% endif %}
            </div>
        {% endcase %}
      </li>
    {%- endfor -%}
  </ul>

  <script>
    let readMoreTextBtns = document.querySelectorAll('.js--read-more-text__toggle');

    readMoreTextBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const container = btn.closest('.read-more-text__description');
        const shortText = container.querySelector('.read-more-text__short');
        const fullText = container.querySelector('.read-more-text__full');
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        if (isExpanded) {
          shortText.style.display = 'block';
          fullText.style.display = 'none';
          btn.textContent = 'Read more';
          btn.setAttribute('aria-expanded', 'false');
        } else {
          shortText.style.display = 'none';
          fullText.style.display = 'block';
          btn.textContent = 'Read less';
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  </script>
</section>
{% schema %}
{
  "name": "Viburnum Grid",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "content-width",
          "label": "Content width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "checkbox",
      "id": "bleed",
      "default": false,
      "label": "Left and Right Padding"
    },
    {
      "type": "text",
      "id": "section_css_class",
      "label": "Section CSS Class"
    },
    {
      "type": "checkbox",
      "id": "detect_when_in_view",
      "default": false,
      "label": "Detect When In View"
    },
    {
      "type": "text",
      "id": "column-gap",
      "default": "0",
      "label": "Column Gap (Include px,%,vw)"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Text Alignment"
    },
    {
      "type": "select",
      "id": "align_items",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "End"
        }
      ],
      "default": "center",
      "label": "Align Items"
    },
    {
      "type": "text",
      "id": "row-gap",
      "default": "0",
      "label": "Row Gap (Include px,%,vw)"
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading"
    },
    {
      "type": "header",
      "content": "Desktop Layout"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "options": [
        {
          "value": "1",
          "label": "1 Column"
        },
        {
          "value": "2",
          "label": "2 Columns"
        },
        {
          "value": "3",
          "label": "3 Columns"
        },
        {
          "value": "4",
          "label": "4 Columns"
        },
        {
          "value": "5",
          "label": "5 Columns"
        },
        {
          "value": "6",
          "label": "6 Columns"
        },
        {
          "value": "7",
          "label": "7 Columns"
        },
        {
          "value": "8",
          "label": "8 Columns"
        }
      ],
      "default": "3",
      "label": "Desktop Columns"
    },
    {
      "type": "text",
      "id": "custom-breakpoint",
      "default": "767",
      "label": "Breakpoint"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "1 Column"
        },
        {
          "value": "2",
          "label": "2  Columns"
        },
        {
          "value": "3",
          "label": "3 Columns"
        },
        {
          "value": "4",
          "label": "4 Columns"
        },
        {
          "value": "5",
          "label": "5 Columns"
        },
        {
          "value": "6",
          "label": "6 Columns"
        },
        {
          "value": "7",
          "label": "7 Columns"
        },
        {
          "value": "8",
          "label": "8 Columns"
        }
      ],
      "default": "4",
      "label": "Mobile Columns"
    },
    {
      "type": "checkbox",
      "id": "reverse-on-mobile",
      "default": false,
      "label": "Reverse On Mobile"
    }
  ],
  "blocks": [
    {
      "type": "feature_card",
      "name": "Feature Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Feature Card Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Feature Card Video"
        },
        {
          "type": "text",
          "id": "feature_card_heading",
          "label": "Feature Card Heading"
        },
        {
          "type": "richtext",
          "id": "feature_card_text",
          "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>",
          "label": "Feature Card Text"
        },
        {
          "type": "url",
          "id": "feature_card_url",
          "label": "Feature Card Url"
        },
        {
          "type": "text",
          "id": "feature_card_button_text",
          "label": "Feature Card Button Text"
