{%- style -%}
  #shopify-section-{{ section.id }} {

  }
  #shopify-section-{{ section.id }} .v-grid{
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0,1fr));
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: {{ section.settings.max-width }};
    column-gap: {{ section.settings.column-gap }};
    row-gap: {{ section.settings.row-gap }};
    text-align: {{ section.settings.text_alignment }};
    @media screen and (max-width: {{ section.settings.custom-breakpoint }}px) {
      {% if section.settings.reverse-on-mobile %}
        display: flex;
        flex-flow: column-reverse;
      {%  else %}
        grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0,1fr));
      {%  endif %}
    }
  }

  .v-grid__grid-item{
    width: 100%;
  }

  .v-grid__image{
    width: 100%;
    height: auto;
    display: block;
  }
  .
{%- endstyle -%}

{% comment %} {% assign detect_when_in_view = section.settings.detect_when_in_view %} {% endcomment %}

<section
  class="
    v-grid__section
    {% if section.settings.bleed %} __container-bleed {% endif %}
    {%if section.settings.section_css_class %} {{section.settings.section_css_class}} {% endif %}
  "
>
  {% render 'v-spacing', size: section.settings.top_padding %}

  {% if section.settings.section_heading != blank %}
    <div class="title-wrapper">
      <h2 class="section-title">
        {{- section.settings.section_heading | escape -}}
      </h2>
    </div>
  {% endif %}
  <ul class="v-grid __align-{{section.settings.align_items}} __justify-{{section.settings.justify_items}}">
    {%- for block in section.blocks -%}
      <li class="v-grid__grid-item">
        {% case block.type %}
          {% when 'feature_card' %}
            {%- liquid
              assign card_alt = block.settings.image.alt | default: block.settings.feature_card_text | strip_html
              assign full_card_link = block.settings.link_whole_feature_card
            -%}

            {% if block.settings.video != blank %}
              {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false }}
            {% endif %}

            {%- if block.settings.image -%}
              {{
                block.settings.image
                | image_url: width: 3200
                | image_tag:
                  loading: 'lazy',
                  widths: '200, 400, 600, 800, 1200, 1600, 2000, 3200',
                  sizes: '(min-width: 990px) 33vw, 100vw',
                  alt: card_alt,
                  class: 'v-grid__image'
              }}
            {%- endif -%}

            {%- if block.settings.feature_card_heading != blank -%}
              <h1 class="feature-card__heading __h1">
                {{ block.settings.feature_card_heading }}
              </h1>
            {%- endif -%}

            {%- if block.settings.feature_card_text -%}
              <div class="feature-card__text">{{ block.settings.feature_card_text }}</div>
            {%- endif -%}
            {%- if block.settings.feature_card_url -%}
              <div>
                <a
                  href="{{ block.settings.feature_card_url }}"
                  class="__cta {%- if block.settings.feature_card_url -%} full_card_link {%- endif -%}"
                >
                  {{ block.settings.feature_card_button_text }}
                </a>
              </div>
            {%- endif -%}

            {%- if block.settings.feature_card_url and block.settings.feature_card_url -%}
              <a
                href="{{ block.settings.feature_card_url }}"
                class="__link-covered"
              >
              </a>
            {%- endif -%}

          {% when 'read_more_text' %}
            {% style %}
              .read-more-text__toggle {
                background: none;
                border: none;
                padding: 0;
                margin-top: 8px;
                color: inherit;
                text-decoration: underline;
                cursor: pointer;
                font-weight: normal;
                &:hover {
                  text-decoration: none;
                }
              }
            {% endstyle %}
            {% assign raw_text = block.settings.read_more_text_description | strip_html %}
            {% assign word_limit = 30 %}
            {% comment %} Adjust desired word limit here {% endcomment %}
            <div class="read-more-text__description">
              {% if raw_text.size > 0 %}
                {% assign word_count = raw_text | split: ' ' | size %}

                {% if word_count > word_limit %}
                  {% comment %} {%- Shortened version shown by default -%} {% endcomment %}
                  <div class="read-more-text__short">
                    <p>{{ raw_text | truncatewords: word_limit, '...' }}</p>
                  </div>

                  {% comment %} {%- Full rich text version hidden by default -%} {% endcomment %}
                  <div class="read-more-text__full" style="display: none;">
                    {{ block.settings.read_more_text_description }}
                  </div>

                  <button type="button" class="read-more-text__toggle js--read-more-text__toggle" aria-expanded="false">
                    Read more
                  </button>
                {% else %}
                  {% comment %} {%- Text is short enough, display directly -%} {% endcomment %}
                  <div class="read-more-text__full">
                    {{ block.settings.read_more_text_description }}
                  </div>
                {% endif %}
              {% endif %}
            </div>
          {% when 'gallery_image' %}
            {% style %}
              .v-gallery-thumb__btn {
                display: block;
                padding: 0;
                border: 0;
                aspect-ratio: 1 / 1;
              }
              .v-gallery-thumb__img {
                display: block;
                object-fit: cover;
                width: 100%;
                height: 100%;
              }
            {% endstyle %}
            <button
              type="button"
              class="v-gallery-thumb__btn js--v-gallery-open"
              data-index="{{ forloop.index0 }}"
              data-full-src="{{ block.settings.image | image_url: width: 1600 }}"
              data-alt="{{ block.settings.image.alt | escape }}"
              aria-label="Open image {{ forloop.index }} in lightbox"
            >
              <img
                src="{{ block.settings.image | image_url: width: 400 }}"
                alt="{{ block.settings.image.alt | escape }}"
                class="v-gallery-thumb__img"
                loading="lazy"
              />
            </button>
        {% endcase %}
      </li>
    {%- endfor -%}
  </ul>

  {%- comment -%}
    ======================================================
    CONDITIONAL MODAL & SCRIPTS (Rendered once outside loop)
    ======================================================
  {%- endcomment -%}

  {%- assign gallery_blocks = section.blocks | where: 'type', 'gallery_image' -%}
  {%- if gallery_blocks.size > 0 -%}
    {{ 'v-media-gallery.css' | asset_url | stylesheet_tag }}
    <!-- Single Modal Markup -->
    <div
      id="v-gallery-modal"
      class="v-gallery-modal"
      role="dialog"
      aria-modal="true"
      aria-label="Image Gallery"
      aria-hidden="true"
    >
      <div class="v-modal-overlay" data-close></div>
      <div class="v-modal-content">
        <div class="v-modal-top-bar">
          <button type="button" class="icon-btn close-btn" data-close aria-label="Close modal">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M18 6L6 18M6 6l12 12"/>
            </svg>
          </button>
        </div>

        <div class="v-modal-image-wrapper">
          <img id="modal-active-img" src="" alt="" />
        </div>

        <button type="button" class="v-icon-btn nav-btn prev-btn" id="modal-prev" aria-label="Previous image">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M15 18l-6-6 6-6"/>
          </svg>
        </button>

        <button type="button" class="v-icon-btn nav-btn next-btn" id="modal-next" aria-label="Next image">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </button>
      </div>
    </div>
    <script src="{{ 'v-media-gallery.js' | asset_url }}" defer></script>
  {%- endif -%}

  {%- assign read_more_blocks = section.blocks | where: 'type', 'read_more_text' -%}
  {%- if read_more_blocks.size > 0 -%}
    <script src="{{ 'v-read-more-toggle.js' | asset_url }}" defer></script>
  {%- endif -%}

  {% render 'v-spacing', size: section.settings.bottom_padding %}
</section>

