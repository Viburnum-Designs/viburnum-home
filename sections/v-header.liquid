<script
  type="application/json"
  data-section-type="static-header"
  data-section-id="{{ section.id }}"
  data-section-data
>
  {
    "stickyHeader": {{ section.settings.sticky_header }},
    "compactCenter": "{{ section.settings.header_layout }}"
  }
</script>
<section data-section-header>
  <header
    class="v--main-header"
    role="banner"
    data-header-main
  >
    <section class="secondary-nav-bar ">
      <nav class=" __container  __container-bleed">
        <ul class="secondary-nav-bar__menu">
          {% for link in linklists['header-secondary-nav'].links %}
            <li class="main-nav-bar__links__menu__item">
              <a href="{{ link.url }}" class="secondary-nav-bar__menu_link">{{ link.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    </section>
    <section class="v--header-grid  __container  __container-bleed">
      <div class="v--header-grid__grid-item__menu-btn">
        <button class="js--toggle-mobile-menu" aria-label="Menu">
          <span class="material-symbols-outlined">menu</span>
        </button>
      </div>

      <h1 class="v--header-grid__grid-item__logo">
        <a href="/" class="v--header-grid__grid-item__logo__link">
          <img
            src="https://cdn.shopify.com/s/files/1/0599/9837/1980/files/header-logo.avif?v=1785773201"
            width="138"
            height="150"
            class="v--header-grid__grid-item__logo__image"
            alt="A minimalist white circular logo with the text 'V & C O.' in a light gray serif font, set against a solid white background."
          >
          <div class="v--header-grid__grid-item__logo__text">VIBURNUM HOME</div>
        </a>
      </h1>

      <div class="v--header-grid__grid-item__nav">
        <div class="mobile-navbar__wrapper">
          <nav class="main-nav-bar__links">
            <ul class="main-nav-bar__links__menu">
              {% for link in linklists['header-main-nav'].links %}
                <li class="main-nav-bar__links__menu__item">
                  {% if link.links.size > 0 %}
                    <div class="main-nav-bar__top-level-grid">
                      <a href="{{ link.url }}" class="main-nav-bar__links__menu__item__link">{{ link.title }}</a>
                      <button
                        type="button"
                        class="main-nav-bar__submenu-toggle js--submenu-toggle"
                        aria-expanded="false"
                        aria-controls="submenu-{{ forloop.index }}"
                      >
                        <span class="visually-hidden">Show submenu for {{ link.title }}</span>
                        <svg
                          class="main-nav-bar__submenu-toggle__icon"
                          width="12"
                          height="12"
                          viewBox="0 0 12 12"
                          aria-hidden="true"
                        >
                          <path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/>
                        </svg>
                      </button>
                    </div>
                    <ul id="submenu-{{ forloop.index }}" class="main-nav-bar__submenu">
                      {% for sublink in link.links %}
                        <li class="main-nav-bar__submenu__item">
                          <a href="{{ sublink.url }}" class="main-nav-bar__submenu__item__link">{{ sublink.title }}</a>
                        </li>
                      {% endfor %}
                    </ul>
                  {% else %}
                    <a href="{{ link.url }}" class="main-nav-bar__links__menu__item__link">{{ link.title }}</a>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>

            <div class="mobile-secondary-links">
              <ul class="secondary-nav-bar__menu">
                {% for link in linklists['header-secondary-nav'].links %}
                  <li class="main-nav-bar__links__menu__item">
                    <a href="{{ link.url }}" class="secondary-nav-bar__menu_link">{{ link.title }}</a>
                  </li>
                {% endfor %}
              </ul>
            </div>
          </nav>
        </div>
        <!-- mobile-nav-wrapper -->
      </div>
      <div class="v--header-grid__grid-item__account-items">
        {% if shop.customer_accounts_enabled %}
          <div class="customer-links">
            {% if customer %}
              <a href="{{ routes.account_url }}">
                <div class="__account-icon">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    height="24px"
                    viewBox="0 -960 960 960"
                    width="24px"
                    fill="#6e776b"
                  >
                    <path d="M367-527q-47-47-47-113t47-113q47-47 113-47t113 47q47 47 47 113t-47 113q-47 47-113 47t-113-47ZM160-160v-112q0-34 17.5-62.5T224-378q62-31 126-46.5T480-440q66 0 130 15.5T736-378q29 15 46.5 43.5T800-272v112H160Zm80-80h480v-32q0-11-5.5-20T700-306q-54-27-109-40.5T480-360q-56 0-111 13.5T260-306q-9 5-14.5 14t-5.5 20v32Zm296.5-343.5Q560-607 560-640t-23.5-56.5Q513-720 480-720t-56.5 23.5Q400-673 400-640t23.5 56.5Q447-560 480-560t56.5-23.5ZM480-640Zm0 400Z"/>
                  </svg>
                </div>

                {% comment %} {{ 'layout.header.my_account' | t }} {% endcomment %}
              </a>
              <div class="customer-links-inner">
                <span class="arrow"></span>
                <ul>
                  <li>
                    <a href="{{ routes.account_url }}">
                      {{ 'customers.general.purchases' | t -}}
                    </a>
                  </li>
                  <li>
                    <a href="{{ routes.account_addresses_url }}">{{ 'customers.addresses.header' | t }}</a>
                  </li>
                  <li>
                    {{ 'layout.header.logout' | t | customer_logout_link -}}
                    <br>
                    Account
                  </li>
                </ul>
              </div>

            {% else %}
              <a class="customer-login-link" href="{{ routes.account_login_url }}">
                <div class="__account-icon">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    height="24px"
                    viewBox="0 -960 960 960"
                    width="24px"
                    fill="#6e776b"
                  >
                    <path d="M480-120v-80h280v-560H480v-80h280q33 0 56.5 23.5T840-760v560q0 33-23.5 56.5T760-120H480Zm-80-160-55-58 102-102H120v-80h327L345-622l55-58 200 200-200 200Z"/>
                  </svg>
                </div>
                {% comment %} {% render 'icons', id: 'account' %} {% endcomment %}
                {% comment %} <span class="__screen-reader">{{ 'layout.header.account' | t -}}</span> {% endcomment %}
              </a>
            {% endif %}
          </div>
        {% endif %}

        <div class="mini-cart-wrapper">
          <a class="cart-count" href="{{ routes.cart_url }}" data-cart-count>
            {% render 'icons', id: 'cart' %}
            <span class="cart-count-text __screen-reader">{{ 'layout.header.cart' | t }}</span>
            <span class="cart-bubble"
              ><span class="cart-count-number">{{ cart.item_count }}</span></span
            >
          </a>

          {% render 'mini-cart' %}
        </div>

        <div class="toggle-search-section js--toggle-search-btn">
          <button class="search-icon__btn" aria-label="Search">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#242424"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              style="display: inline-block; vertical-align: middle;"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </button>
        </div>
        {% comment %}
          <form class="checkout-link" action="{{ routes.cart_url }}" method="POST">
            <button class="checkout-link__button" type="submit" name="checkout">{{ 'layout.header.checkout' | t }}</button>
          </form>
        {% endcomment %}
      </div>
    </section>

    <section
      class="search-form-section js--toggle-search-panel"
      id="predictive-search"
      role="dialog"
      aria-modal="true"
      aria-label="Search"
      aria-hidden="true"
    >
      <div class="search-form-section__grid __container __container-bleed">
        <button
          class="header-search-button-close js--close-search-btn"
          aria-label="Close Search"
          type="button"
        >
          {%- render 'icons', id: 'close' -%}
        </button>
        <form
          class="header-search-form"
          action="{{ routes.search_url }}"
          method="get"
          data-header-search
        >
          <label for="header-search-input" class="visually-hidden"> Search </label>
          <input
            class="header-search-input"
            id="header-search-input"
            name="q"
            type="search"
            placeholder="Search"
            value="{{ search.terms }}"
            autocomplete="off"
          >
          <input
            class="header-search-button"
            type="submit"
            value="&#xe606;"
            aria-label="{{ 'layout.header.search_submit' | t }}"
            data-header-search-button
          >
        </form>
      </div>
    </section>
  </header>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.querySelector('.js--toggle-mobile-menu');
    const menuNav = document.querySelector('.mobile-navbar__wrapper');
    const subMenuBtns = document.querySelectorAll('.js--submenu-toggle');
    const toggleSearchBtn = document.querySelector('.js--toggle-search-btn');
    const searchPanel = document.querySelector('.js--toggle-search-panel');
    const closeSearchBtn = document.querySelector('.js--close-search-btn');
    const searchInput = searchPanel ? searchPanel.querySelector('input[type="search"], input[type="text"]') : null;

    function closeMenu() {
      menuNav.classList.remove('is-open');
      toggleBtn.setAttribute('aria-expanded', 'false');
    }

    // Toggle button click
    toggleBtn.addEventListener('click', (event) => {
      event.stopPropagation();
      const isOpen = menuNav.classList.toggle('is-open');
      toggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });

    //ToggleSubMenu Button Click
    subMenuBtns.forEach((btn) => {
      btn.addEventListener('click', (event) => {
        let subMenu = btn.closest('.main-nav-bar__links__menu__item');
        if (subMenu.classList.contains('is-open')) {
          subMenu.classList.remove('is-open');
        } else {
          subMenu.classList.add('is-open');
        }
      });
    });

    // Close menu when clicking directly on the overlay background
    menuNav.addEventListener('click', (event) => {
      // Check if the click target is the overlay container itself (and not its children)
      if (event.target === menuNav) {
        closeMenu();
      }
    });

    // Close menu on Escape key press
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuNav.classList.contains('is-open')) {
        closeMenu();
      }
    });

    // --- Search panel ---
    if (toggleSearchBtn && searchPanel) {
      // Ensure baseline ARIA attributes exist even if not set in Liquid markup
      if (!toggleSearchBtn.hasAttribute('aria-expanded')) {
        toggleSearchBtn.setAttribute('aria-expanded', 'false');
      }
      if (!searchPanel.hasAttribute('aria-hidden')) {
        searchPanel.setAttribute('aria-hidden', 'true');
      }
      toggleSearchBtn.setAttribute('aria-controls', searchPanel.id || 'search-panel');
      if (!searchPanel.id) {
        searchPanel.id = 'search-panel';
      }

      function openSearch() {
        searchPanel.classList.add('is-open');
        searchPanel.setAttribute('aria-hidden', 'false');
        toggleSearchBtn.setAttribute('aria-expanded', 'true');

        // Move focus into the panel so keyboard/screen reader users land in context
        if (searchInput) {
          searchInput.focus();
        } else {
          searchPanel.setAttribute('tabindex', '-1');
          searchPanel.focus();
        }
      }

      function closeSearch({ returnFocus = true } = {}) {
        searchPanel.classList.remove('is-open');
        searchPanel.setAttribute('aria-hidden', 'true');
        toggleSearchBtn.setAttribute('aria-expanded', 'false');

        // Return focus to the trigger so keyboard users don't lose their place
        if (returnFocus) {
          toggleSearchBtn.focus();
        }
      }

      toggleSearchBtn.addEventListener('click', (event) => {
        event.stopPropagation();
        const isOpen = searchPanel.classList.contains('is-open');
        if (isOpen) {
          closeSearch();
        } else {
          openSearch();
        }
      });

      if (closeSearchBtn) {
        closeSearchBtn.addEventListener('click', (event) => {
          event.stopPropagation();
          closeSearch();
        });
      }

      // Close search on Escape key press
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && searchPanel.classList.contains('is-open')) {
          closeSearch();
        }
      });

      // Close search when clicking directly on the overlay background (if applicable)
      searchPanel.addEventListener('click', (event) => {
        if (event.target === searchPanel) {
          closeSearch();
        }
      });

      // Basic focus trap while search panel is open
      searchPanel.addEventListener('keydown', (event) => {
        if (event.key !== 'Tab') return;

        const focusableSelectors =
          'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
        const focusableEls = Array.from(searchPanel.querySelectorAll(focusableSelectors)).filter(
          (el) => el.offsetParent !== null
        );
        if (!focusableEls.length) return;

        const firstEl = focusableEls[0];
        const lastEl = focusableEls[focusableEls.length - 1];

        if (event.shiftKey && document.activeElement === firstEl) {
          event.preventDefault();
          lastEl.focus();
        } else if (!event.shiftKey && document.activeElement === lastEl) {
          event.preventDefault();
          firstEl.focus();
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "V Header",
  "settings": [],
  "presets": [
    {
      "name": "V Footer",
      "category": "Viburnum Sections"
    }
  ]
}
{% endschema %}
