<footer class="v--main-footer">
  <div class="__container-bleed">
    <div class="footer-grid">
      <div class="footer-grid__item footer-grid__image">
        <img
          src="https://cdn.shopify.com/s/files/1/0599/9837/1980/files/footer-image-smaller.webp?v=1786037312"
          class="footer-image"
          alt=""
          width="536"
          height="552"
        >
      </div>

      <div class="footer-grid__item">
        <div class="footer-grid__logo-and-signup">
          <div class="footer-grid__logo-and-signup__item">
            <div class="footer-logo">
              <div class="footer-logo__site-name">VIBURNUM HOME</div>
            </div>
          </div>
          <div class="footer-grid__logo-and-signup__item">
            {%- for block in section.blocks -%}
              {%- if block.type == 'newsletter' -%}
                <div class="v--mailing-list">
                  <h2 class="signup-heading">Subscribe to our newsletter!</h2>
                  {% form 'customer' %}
                    {% if form.posted_successfully? %}
                      <p class="mailing-list-success">
                        {{ 'general.newsletter.success' | t }}
                      </p>
                    {% else %}
                      <p class="mailing-list-error">
                        {{ form.errors | default_errors }}
                      </p>
                    {% endif %}

                    <div class="mailing-list-input">
                      <input
                        class="mailing-list-email"
                        name="contact[email]"
                        type="email"
                        placeholder="Email Address"
                        value=""
                      >
                      <input type="hidden" id="contact_tags" name="contact[tags]" value="prospect,newsletter">
                      <div class="mailing-list-submit">
                        <input
                          class="submit"
                          name="Sign Up"
                          type="submit"
                          value="Sign Up"
                        >
                      </div>
                    </div>
                  {% endform %}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        <div class="footer-grid__links">
          <div class="footer-grid__links-item">
            <details class="collapsible-tab">
              <summary class="collapsible-tab__heading">
                <h2 class="footer-grid__links-heading">Info</h2>
                <span class="collapsible-tab__icon"></span>
              </summary>
              <ul class="footer-info-menu">
                {% for link in linklists['footer-info-menu'].links %}
                  <li class="footer-info-menu__item">
                    <a href="{{ link.url }}" class="footer-info-menu__item__link">{{ link.title }}</a>
                  </li>
                {% endfor %}
              </ul>
            </details>
          </div>

          <div class="footer-grid__links-item">
            <details class="collapsible-tab">
              <summary class="collapsible-tab__heading">
                <h2 class="footer-grid__links-heading">Follow Us</h2>
                <span class="collapsible-tab__icon"></span>
              </summary>
              <div class="upper-footer-item footer-linklist">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'social-links' -%}
                    {%- render 'v-social' -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </details>
          </div>

          <div class="footer-grid__links-item">
            {%- assign address_blocks = section.blocks | where: 'type', 'address' -%}
            {%- if address_blocks.size > 0 -%}
              <div class="retail-stores">
                <details class="collapsible-tab">
                  <summary class="collapsible-tab__heading">
                    <h2 class="footer-grid__links-heading">Connect</h2>
                    <span class="collapsible-tab__icon"></span>
                  </summary>
                  {% if section.settings.connect_info != blank %}
                    <div class="connect-info-wrapper">
                      {{ section.settings.connect_info }}
                    </div>
                  {% endif %}
                  <h3 class="footer__sub-heading">Retail Stores</h3>
                  <ul class="address-list">
                    {%- for block in address_blocks -%}
                      <li class="address-list__item">
                        {% render 'icons', id: 'map-pin' %}
                        {{ block.settings.address_text }}
                      </li>
                    {%- endfor -%}
                  </ul>
                </details>
              </div>
            {%- endif -%}
          </div>

          <div class="footer-grid__links-item footer-grid__links-item__policy-links">
            <div class="footer__policy-links">
              <details class="collapsible-tab">
                <summary class="collapsible-tab__heading">
                  <h2 class="footer-grid__links-heading">Policies</h2>
                  <span class="collapsible-tab__icon"></span>
                </summary>
                <ul class="footer-policy-menu">
                  {% for link in linklists['footer-policy-menu'].links %}
                    <li class="footer-policy-menu__item">
                      <a href="{{ link.url }}" class="footer-policy-menu__item__link">{{ link.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              </details>
            </div>
          </div>
          <!-- /footer-grid__links-item (Policies) -->
        </div>
        <!-- /footer-grid__links -->
      </div>
      <!-- /footer-grid__item -->
    </div>
    <!-- /footer-grid -->
  </div>
  <!-- /__container-bleed -->

  <div class="v--copyright-bar __container-v-padding">
    <div class="__container __container-bleed">
      <div class="">
        <div class="copyright" role="contentinfo">
          Copyright &copy; {{ 'now' | date: '%Y' }}
          {{- shop.name | strip -}}
          .
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  (function () {
    const mq = window.matchMedia('(min-width: 750px)'); // match your theme's breakpoint
    const tabs = document.querySelectorAll('.v--main-footer details.collapsible-tab');

    function syncTabs() {
      tabs.forEach((el) => {
        if (mq.matches) el.setAttribute('open', '');
        else el.removeAttribute('open');
      });
    }

    // Block toggling on desktop (Enter/Space on a summary also fire click)
    tabs.forEach((el) => {
      el.querySelector('summary').addEventListener('click', (e) => {
        if (mq.matches) e.preventDefault();
      });
    });

    mq.addEventListener('change', syncTabs);
    syncTabs();
  })();
</script>

{% schema %}
{
  "name": "V Footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "richtext",
      "id": "connect_info",
      "label": "Connect Info",
      "default": "<h2>Heading</h2><p>Add your detailed connection info and paragraphs here.</p>"
    }
  ],
  "blocks": [
    {
      "type": "social-links",
      "name": "Social links",
      "settings": [
        {
          "type": "paragraph",
          "content": "Social media account settings can be found in the \"social media\" section of \"theme settings\"."
        }
      ],
      "limit": 1
    },
    {
      "type": "address",
      "name": "Address",
      "settings": [
        {
          "type": "richtext",
          "id": "address_text",
          "label": "Address text",
          "default": "<p>Add Address Here</p>"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "settings": [],
      "limit": 1
    }
  ],
  "presets": [
    {
      "name": "V Footer",
      "category": "Viburnum Sections"
    }
  ]
}
{% endschema %}
