<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
  rel="stylesheet"
>

<style>
  :root {
    --heading-font: 'Cormorant Garamond', serif;
    --body-font: ;
    --footer-link-color: #fff;
    --footer-link-color-hover: #ccc;
  }
  .v--main-footer {
    background-color: #393939;
    color: #fff;
  }

  .v--copyright-bar {
    background-color: #000;
    @media screen and (max-width: 768px){
      text-align: center;
    }
  }

  .__container-bleed {
    padding-left: 25px;
    padding-right: 25px;
  }

  .__container-v-padding {
    padding-top: 25px;
    padding-bottom: 25px;
  }

  .__padding-t {
    padding-top: 25px;
  }
  .__container {
    max-width: 1260px;
    margin-left: auto;
    margin-right: auto;
  }

  .footer-grid {
    --gap: 40px;
    display: grid;
    gap: var(--gap);
    align-items: center;
    @media screen and (min-width: 1000px) {
      grid-template-columns: 0.28fr 0.72fr;
    }
  }

  .footer-grid__item {
    display: flex;
    flex-direction: column;
  }

  @media screen and (max-width: 1000px){
    .footer-grid__image{
      height: 30vw;
      overflow: hidden;
    }
  }


  .footer-image {
    display: block;
    object-fit: cover;
    @media screen and (max-width: 999px) {
      margin-top: -77vw;
      width: 100%;
      height: auto;
    }
  }

  .footer-grid__links {
    max-width: 900px;
    width: 100%;
    align-self: center;
    gap: var(--gap);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    @media screen and (max-width: 769px) {
      order: 2;
    }
    @media screen and (min-width: 770px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 769px) {
    .footer-grid__links-item {
      text-align: center;
    }
    .footer-grid__links-item:nth-child(3) {
      grid-column: span 2;
    }
  }



  .footer-grid__logo-and-signup {
    @media screen and (max-width: 769px) {
      order: 1;
    }
    @media screen and (min-width: 770px) {
      max-width: 900px;
      width: 100%;
      align-self: center;
      align-items: center;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      margin-top: -50px;
    }
  }

  .footer-grid__links-heading {
    color: #fff;
    font-size: 20px;
    font-family: var(--heading-font);
    letter-spacing: 0.2em;
  }

  .footer-logo {
    width: 182px;
    height: auto;
    margin-left: auto;
    margin-right: auto;
    @media screen and (max-width: 769px) {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
      padding-bottom: 20px;
      width: auto;
    }

  }

  @media screen and (max-width: 769px) {
    .footer-logo__image {
        width: 100px;
        height: auto;
    }
  }

  .footer-logo__site-name {
    text-align: center;
    font-size: 28px;
    line-height: 1.25;
    font-family: var(--heading-font);
    @media screen and (max-width: 769px) {
      br {
        display: none;
      }
    }
  }

  .footer-policy-menu {
    display: flex;
    gap: 20px;
    justify-content: space-between;
    max-width: 850px;
    width: 100%;
    align-self: center;
    @media screen and (max-width: 769px) {
      flex-direction: column;
      text-align: center;
      border-top: 1px solid #484848;
      padding-top: 30px;
      order: 3;
    }
  }

  .social-link,
  .footer-policy-menu__item__link,
  .footer-info-menu__item__link {
    line-height: 1.6em;
    font-size: 15px;
    color: var(--footer-link-color);
    &:hover {
      color: var(--footer-link-color-hover);
    }
    &:focus-visible {
      color: var(--footer-link-color-hover);
    }
  }

  {% comment %} @media (max-width: 769px) {
    .footer-linklist {
      text-align: left;
    }
  } {% endcomment %}

  .social li,
  .footer-info-menu__item {
    padding: 5px 0;
  }

  .social-link svg {
    display: none;
  }

  .connect-info-wrapper a {
    color: #fff;
    text-decoration: underline;
  }

  .connect-info-wrapper a:hover {
    color: #fff;
    text-decoration: none;
  }

  .signup-heading {
    font-family: var(--heading-font);
    color: #fff;
  }

  .v--mailing-list {
    background-color: #646464;
    border-radius: 3px;
    padding: 20px;
  }

  .v--mailing-list :where(h2, p, .contact-form) {
    margin: 0;
    padding: 0;
  }
</style>

<footer
  class="v--main-footer "
>
  <div class="  __container-bleed">
    <div class="footer-grid">
      <div class="footer-grid__item footer-grid__image">
        <img
          src="https://cdn.shopify.com/s/files/1/0599/9837/1980/files/footer-image.avif?v=1785438917"
          class="footer-image"
          alt="empty"
          width="536"
          height="626"
        >
      </div>

      <div class="footer-grid__item">
        <div class="footer-grid__links __padding-t ">
          <div class="footer-grid__links-item ">
            <h2 class="footer-grid__links-heading">INFO</h2>
            <ul class="footer-info-menu">
              {% for link in linklists['footer-info-menu'].links %}
                <li class="footer-info-menu__item">
                  <a href="{{ link.url }}" class="footer-info-menu__item__link">{{ link.title }}</a>
                </li>
              {% endfor %}
            </ul>
          </div>
          <div class="footer-grid__links-item">
            <h2 class="footer-grid__links-heading">FOLLOW US</h2>

            <div class="upper-footer-item footer-linklist">
              {%- for block in section.blocks -%}
                {%- if block.type == 'social-links' -%}
                  {%- render 'social' -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
          <div class="footer-grid__links-item">
            <h2 class="footer-grid__links-heading">CONNECT</h2>
            {% if section.settings.connect_info != blank %}
              <div class="connect-info-wrapper">
                {{ section.settings.connect_info }}
              </div>
            {% endif %}
          </div>
        </div>
        <div class="footer-grid__logo-and-signup">
          <div class="footer-grid__logo-and-signup__item">
            <div class="footer-logo">
              <img
                src="https://cdn.shopify.com/s/files/1/0599/9837/1980/files/footer-logo.avif?v=1785438917"
                class="footer-logo__image"
                width="182"
                height="193"
              >
              <div class="footer-logo__site-name">
                VIBURNUM<br>
                HOME
              </div>
            </div>
          </div>
          <div class="footer-grid__logo-and-signup__item">
            {%- for block in section.blocks -%}
              {%- if block.type == 'newsletter' -%}
                <div class="v--mailing-list">
                  <h2 class="signup-heading">Subscribe to our newsletter!</h2>
                  <p>Email*</p>
                  {% form 'customer' %}
                    {% if form.posted_successfully? %}
                      <p class="mailing-list-success">
                        {{ 'general.newsletter.success' | t }}
                      </p>
                    {% else %}
                      <p class="mailing-list-error">
                        {{ form.errors | default_errors }}
                      </p>
                    {% endif %}

                    <div class="mailing-list-input">
                      <input
                        class="mailing-list-email"
                        name="contact[email]"
                        type="email"
                        placeholder="your@email.com"
                        value=""
                      >
                      <input type="hidden" id="contact_tags" name="contact[tags]" value="prospect,newsletter" />
                      <div class="mailing-list-submit">
                        <input
                          class="submit"
                          name="subscribe"
                          type="submit"
                          value="{{ 'general.newsletter.subscribe'| t }}"
                        >
                      </div>
                    </div>
                  {% endform %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <ul class="footer-policy-menu">
          {% for link in linklists['footer-policy-menu'].links %}
            <li class="footer-policy-menu__item">
              <a href="{{ link.url }}" class="footer-policy-menu__item__link">{{ link.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
  <div class="v--copyright-bar __container-v-padding">
    <div class="__container __container-bleed">
      <div class="">
        {% capture year %}
          {{ "now" | date: "%Y" }}
        {% endcapture %}
        {% capture shopName %}
          {{ shop.name }}
        {% endcapture %}
        <div class="copyright" role="contentinfo">
          {{ 'general.general.copyright_html' | t: year: year, shop_name: shopName }}
        </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "V Footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "richtext",
      "id": "connect_info",
      "label": "Connect Info",
      "default": "<h2>Heading</h2><p>Add your detailed connection info and paragraphs here.</p>"
    }
  ],
  "blocks": [
    {
      "type": "social-links",
      "name": "Social links",
      "settings": [
        {
          "type": "paragraph",
          "content": "Social media account settings can be found in the \"social media\" section of \"theme settings\"."
        }
      ],
      "limit": 1
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "settings": [],
      "limit": 1
    }
  ],
  "presets": [
    {
      "name": "V Footer",
      "category": "Viburnum Sections"
    }
  ]
}
{% endschema %}
