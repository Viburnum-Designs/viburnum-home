{{ 'v-trade-form.css' | asset_url | stylesheet_tag }}

{%- assign form_id = 'VTradeForm-' | append: section.id -%}

<section class="v-trade-form-section" id="v-trade-form-{{ section.id }}">
  <div class="v-trade-form-wrap">
    <h2 class="page-title section-title v-trade-form__heading">Apply For A Trade Membership</h2>

    {% if section.settings.intro != blank %}
      <div class="v-trade-form__intro">{{ section.settings.intro }}</div>
    {% endif %}

    {% form 'contact', id: form_id, class: 'v-trade-form' %}
      {%- comment -%} Tags the email so trade applications stand out from general contact messages {%- endcomment -%}
      <input type="hidden" name="contact[Form]" value="Trade Program Application">

      {% if form.posted_successfully? %}
        <div class="v-trade-form__status" data-state="success" role="status" tabindex="-1">
          {{ section.settings.success_message }}
        </div>
      {% else %}
        {% if form.errors %}
          <div class="v-trade-form__status" data-state="error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <p class="v-field__hint">
          Fields marked <span aria-hidden="true">*</span><span class="visually-hidden">with an asterisk</span> are
          required.
        </p>

        <div class="v-field">
          <label for="{{ form_id }}-company">Company name</label>
          <input
            type="text"
            id="{{ form_id }}-company"
            name="contact[Company Name]"
            autocomplete="organization"
            maxlength="200"
          >
        </div>

        <div class="v-field">
          <label for="{{ form_id }}-first-name">First name <span aria-hidden="true">*</span></label>
          <input
            type="text"
            id="{{ form_id }}-first-name"
            name="contact[First Name]"
            autocomplete="given-name"
            maxlength="100"
            required
          >
        </div>

        <div class="v-field">
          <label for="{{ form_id }}-last-name">Last name <span aria-hidden="true">*</span></label>
          <input
            type="text"
            id="{{ form_id }}-last-name"
            name="contact[Last Name]"
            autocomplete="family-name"
            maxlength="100"
            required
          >
        </div>

        <div class="v-field">
          <label for="{{ form_id }}-position">Position</label>
          <input
            type="text"
            id="{{ form_id }}-position"
            name="contact[Position]"
            autocomplete="organization-title"
            maxlength="100"
          >
        </div>

        <div class="v-field-row">
          <div class="v-field">
            <label for="{{ form_id }}-email">Email <span aria-hidden="true">*</span></label>
            <input
              type="email"
              id="{{ form_id }}-email"
              name="contact[email]"
              autocomplete="email"
              spellcheck="false"
              autocapitalize="off"
              required
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="{{ form_id }}-email-error"
              {% endif %}
            >
            {% if form.errors contains 'email' %}
              <p id="{{ form_id }}-email-error" class="v-field__error">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {% endif %}
          </div>

          <div class="v-field">
            <label for="{{ form_id }}-phone">Phone <span aria-hidden="true">*</span></label>
            <input
              type="tel"
              id="{{ form_id }}-phone"
              name="contact[Phone]"
              autocomplete="tel"
              maxlength="25"
              aria-describedby="{{ form_id }}-phone-hint"
              required
            >
            <span id="{{ form_id }}-phone-hint" class="v-field__hint">Include your area code.</span>
          </div>
        </div>

        <div class="v-field">
          <label for="{{ form_id }}-social">Link to social media</label>
          <input
            type="text"
            inputmode="url"
            id="{{ form_id }}-social"
            name="contact[Social Media]"
            autocapitalize="off"
            spellcheck="false"
            maxlength="500"
            aria-describedby="{{ form_id }}-social-hint"
          >
          <span id="{{ form_id }}-social-hint" class="v-field__hint">For example, instagram.com/yourstudio</span>
        </div>

        <div class="v-field">
          <label for="{{ form_id }}-cv">Link to CV or LinkedIn</label>
          <input
            type="text"
            inputmode="url"
            id="{{ form_id }}-cv"
            name="contact[CV or LinkedIn]"
            autocapitalize="off"
            spellcheck="false"
            maxlength="500"
          >
        </div>

        <fieldset class="v-field v-fieldset">
          <legend>
            Approximately how many projects do you complete a year that you think Viburnum Home might be of help to you?
            <span aria-hidden="true">*</span>
          </legend>

          <div class="v-checkbox">
            <input
              type="radio"
              id="{{ form_id }}-projects-1"
              name="contact[Projects Per Year]"
              value="1-3 projects a year"
              required
            >
            <label for="{{ form_id }}-projects-1">1-3 projects a year</label>
          </div>

          <div class="v-checkbox">
            <input
              type="radio"
              id="{{ form_id }}-projects-2"
              name="contact[Projects Per Year]"
              value="4-10 projects a year"
            >
            <label for="{{ form_id }}-projects-2">4-10 projects a year</label>
          </div>

          <div class="v-checkbox">
            <input
              type="radio"
              id="{{ form_id }}-projects-3"
              name="contact[Projects Per Year]"
              value="10+ projects a year"
            >
            <label for="{{ form_id }}-projects-3">10+ projects a year</label>
          </div>
        </fieldset>

        <fieldset class="v-field v-fieldset">
          <legend>
            Can we share photos of your finished projects with our products on our social media?
            <span aria-hidden="true">*</span>
          </legend>

          <div class="v-toggle-group">
            <label class="v-toggle-btn">
              <input type="radio" name="contact[Can Share Photos]" value="Yes" required>
              <span>Yes! Absolutely</span>
            </label>
            <label class="v-toggle-btn">
              <input type="radio" name="contact[Can Share Photos]" value="No">
              <span>No, please don't</span>
            </label>
          </div>
        </fieldset>

        <div class="v-field">
          <label for="{{ form_id }}-message">Anything else we should know?</label>
          <textarea
            id="{{ form_id }}-message"
            name="contact[body]"
            rows="5"
            maxlength="2000"
          ></textarea>
        </div>

        <button type="submit" class="__cta apply-btn">Apply</button>
      {% endif %}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "V Trade Form Simple",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Contact Form Image"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for applying to the Trade Program. We'll review your application and be in touch soon."
    }
  ],
  "presets": [
    {
      "category": "Viburnum Sections",
      "name": "V Trade Form Simple"
    }
  ]
}
{% endschema %}
