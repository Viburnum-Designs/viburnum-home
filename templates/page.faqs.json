        },
        "feature_card_wHQPkL": {
          "type": "feature_card",
          "settings": {
            "feature_card_heading": "",
            "feature_card_text": "<p>How do I care for preserved moss?</p>",
            "feature_card_url": "",
            "feature_card_button_text": ""
          }
        },
        "read_more_text_N3FGm3": {
          "type": "read_more_text",
          "settings": {
            "read_more_text_description": "<p>Preserved moss is completely maintenance-free - no watering, trimming, or sunlight needed. It’s real moss that’s been naturally preserved to stay soft and vibrant for years. To keep it looking its best, display it indoors, out of direct sunlight and humidity. Dust gently with a soft brush or compressed air if needed. Avoid water and cleaning products, as they can damage the moss. With proper care, it will remain beautiful and lush without any effort.<br/></p>"
          }
        },
